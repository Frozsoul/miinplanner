rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getWorkspace(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)).data;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() && 
             workspaceId != null && 
             exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
             request.auth.uid in getWorkspace(workspaceId).memberUids;
    }

    // User Profiles
    match /users/{userId} {
      // Users can only read and write their own profile.
      // Teammate lookups (invite by email, member names) go through server
      // actions in src/services/workspace-members-actions.ts, which use
      // firebase-admin and check workspace membership first.
      allow read, write: if isOwner(userId);

      match /taskSpaces/{spaceId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Workspaces
    match /workspaces/{workspaceId} {
      // Members can read the workspace details
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberUids;
      
      // Any authenticated user can create a workspace (as long as they are the owner and member)
      allow create: if isAuthenticated() && 
                    request.resource.data.ownerId == request.auth.uid &&
                    request.auth.uid in request.resource.data.memberUids;
      
      // Only the workspace owner can manage its settings or members
      allow update, delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Team hub: pinned links. Any member can read, add and remove them.
      match /links/{linkId} {
        allow read, delete: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId)
          && request.resource.data.keys().hasOnly(['title', 'url', 'addedBy', 'createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 100
          && request.resource.data.url is string
          && request.resource.data.url.size() <= 2048
          && request.resource.data.url.matches('https?://.+')
          && request.resource.data.addedBy == request.auth.uid;
      }

      // Team hub: the shared team note (one doc, id "notes"). Any member can read and edit it.
      match /hub/{docId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create, update: if isWorkspaceMember(workspaceId)
          && docId == 'notes'
          && request.resource.data.keys().hasOnly(['text', 'updatedBy', 'updatedByName', 'updatedAt', 'version'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 10000
          && request.resource.data.version is int
          && request.resource.data.updatedBy == request.auth.uid;
      }
    }

    // Tasks: Collaborative rules
    match /tasks/{taskId} {
      // Rule 1: Personal Ownership - Access for the creator
      allow read, update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
      );
      
      // Rule 2: Workspace Membership - Access for any member of the associated workspace
      allow read, update, delete: if isAuthenticated() && 
                                    resource.data.workspaceId != null && 
                                    isWorkspaceMember(resource.data.workspaceId);
      
      // Creation rules - allow if owner OR member of the target workspace
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid || 
        (request.resource.data.workspaceId != null && isWorkspaceMember(request.resource.data.workspaceId))
      );
    }
  }
}